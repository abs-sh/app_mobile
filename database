# database.py
import os
import platform
import flet as ft
from sqlalchemy import create_engine
from sqlalchemy.orm import sessionmaker
from models import Base,SaleInvoice,SaleItem,Supplier,Expense,PurchaseItem,PurchaseInvoice,Customer,Product


def get_db_path(app_name="my_pos_app"):
    # تشخیص سیستم عامل
    system = platform.system()

    if system == "Windows":
        # مسیر AppData برای ویندوز
        base_dir = os.environ.get("APPDATA")
    elif system == "Android":
        # مسیر مخصوص اپلیکیشن در اندروید
        # معمولاً /data/user/0/com.your.app/files
        base_dir = os.environ.get("EXTERNAL_STORAGE") or "/data/data/com.flet.app/files"
    else:
        # برای لینوکس یا سایر سیستم‌ها، پوشه home
        base_dir = os.path.expanduser("~")

    # ساخت مسیر کامل پوشه برنامه
    app_dir = os.path.join(base_dir, app_name)

    if not os.path.exists(app_dir):
        os.makedirs(app_dir)

    return os.path.join(app_dir, "sales_data.db")


def init_db():
    global engine, SessionLocal

    db_path = get_db_path()
    print(f"Database path: {db_path}") # چاپ مسیر برای دیباگ

    # استفاده از sqlite:///{db_path}
    engine = create_engine(f"sqlite:///{db_path}", echo=False)
    Base.metadata.create_all(engine)
    SessionLocal = sessionmaker(bind=engine)
    return SessionLocal()


# توابع برای داشبورد (بر اساس مدل‌های شما)
def get_dashboard_summary(session):
    """خلاصه وضعیت مالی و انباری"""

    # مجموع سود خالص (مجموع فیلد profit در SaleItem)
    from sqlalchemy import func
    total_profit = session.query(func.sum(SaleItem.profit)).scalar() or 0.0

    # مجموع فروش امروز
    from datetime import datetime
    today = datetime.now().date()
    total_sales_today = session.query(func.sum(SaleInvoice.total_amount)) \
                            .filter(func.date(SaleInvoice.created_at) == today).scalar() or 0.0

    # تعداد محصولات رو به اتمام
    low_stock = session.query(Product).filter(Product.stock <= Product.min_stock_alert).count()

    # مجموع هزینه‌های ثبت شده
    total_expenses = session.query(func.sum(Expense.amount)).scalar() or 0.0

    return {
        "profit": total_profit,
        "sales_today": total_sales_today,
        "low_stock": low_stock,
        "expenses": total_expenses
    }
