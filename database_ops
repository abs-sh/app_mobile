# database_ops.py
from database import init_db
from models import Product

def get_all_products():
    db_session = init_db()
    products = db_session.query(Product).all()
    db_session.close() # بستن اتصال برای جلوگیری از Memory Leak
    return products

def add_product_db(name, purchase_price, stock):
    db_session = init_db()
    new_product = Product(name=name, price=purchase_price, stock=stock)
    db_session.add(new_product)
    db_session.commit()
    db_session.close()
    return True
# database_ops.py




def update_product_db(product_id, name, purchase_price, stock):
    db_session = init_db()
    product = db_session.query(Product).filter(Product.id == product_id).first()
    if product:
        product.name = name
        product.purchase_price = purchase_price
        product.stock = stock
        db_session.commit()
    db_session.close()

def delete_product_db(product_id):
    db_session = init_db()
    product = db_session.query(Product).filter(Product.id == product_id).first()
    if product:
        db_session.delete(product)
        db_session.commit()
    db_session.close()
