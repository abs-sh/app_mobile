import flet as ft
from database import init_db, get_dashboard_summary
from models import SaleInvoice


class DashboardView(ft.Container):
    def __init__(self, page: ft.Page):
        super().__init__(expand=True)
        page = page
        self.db_session = init_db()
        # در __init__ کلاس DashboardView
        self.on_sales_clicked = None  # مقدار اولیه

        self.load_ui()

    def load_ui(self):
        stats = get_dashboard_summary(self.db_session)
        recent_sales = self.db_session.query(SaleInvoice).order_by(SaleInvoice.id.desc()).limit(5).all()

        sales_list = ft.Column(spacing=8)
        if not recent_sales:
            sales_list.controls.append(ft.Text("هنوز تراکنشی ثبت نشده است.", color=ft.Colors.GREY_500, italic=True))
        else:
            for sale in recent_sales:
                sales_list.controls.append(
                    ft.Card(
                        elevation=0,
                        content=ft.ListTile(
                            leading=ft.Container(
                                content=ft.Icon(ft.Icons.RECEIPT_LONG, color=ft.Colors.BLUE_800, size=20),
                                padding=8,
                                bgcolor=ft.Colors.BLUE_50,
                                border_radius=10,
                            ),
                            title=ft.Text(f"فاکتور شماره #{sale.id}", weight=ft.FontWeight.W_500),
                            subtitle=ft.Text(f"مبلغ: {sale.total_amount:,} ریال"),
                            trailing=ft.Text(sale.created_at.strftime("%H:%M") if hasattr(sale, 'created_at') else "",
                                             color=ft.Colors.GREY_500, size=12),
                        )
                    )
                )

        self.content = ft.Column(
            [
                ft.Row([
                    ft.Column([
                        ft.Text("پیشخوان مدیریتی", size=24, weight=ft.FontWeight.BOLD),
                        ft.Text("خوش آمدید 👋", size=14, color=ft.Colors.GREY_600),
                    ], spacing=0),
                    ft.IconButton(ft.Icons.NOTIFICATIONS_OUTLINED)
                ], alignment=ft.MainAxisAlignment.SPACE_BETWEEN),

                ft.Divider(height=15, color=ft.Colors.TRANSPARENT),

                ft.ResponsiveRow(
                    [
                        ft.Container(self._create_stat_card("سود", f"{stats['profit']:,}", ft.Icons.MONETIZATION_ON,
                                                            ft.Colors.GREEN_700), col={"xs": 6, "sm": 3}),
                        ft.Container(self._create_stat_card("فروش", f"{stats['sales_today']:,}", ft.Icons.SHOPPING_CART,
                                                            ft.Colors.BLUE_700), col={"xs": 6, "sm": 3},    on_click=lambda _: self.on_sales_clicked()  # فراخوانی متد اصلی
),
                        ft.Container(
                            self._create_stat_card("هشدار موجودی", f"{stats['low_stock']}", ft.Icons.WARNING_AMBER_ROUNDED,
                                                   ft.Colors.ORANGE_700), col={"xs": 6, "sm": 3}),
                        ft.Container(
                            self._create_stat_card("هزینه", f"{stats['expenses']:,}", ft.Icons.ACCOUNT_BALANCE_WALLET,
                                                   ft.Colors.RED_700), col={"xs": 6, "sm": 3}),
                    ],
                ),

                ft.Divider(height=20, color=ft.Colors.TRANSPARENT),

                ft.Text("آخرین تراکنش‌ها", size=18, weight=ft.FontWeight.BOLD),
                ft.Container(
                    content=sales_list,
                    padding=10,
                    border_radius=10,
                    bgcolor=ft.Colors.WHITE,
                ),
            ],
            scroll=ft.ScrollMode.ADAPTIVE,
        )

    def _create_stat_card(self, title, value, icon, color):
        return ft.Card(
            elevation=1,
            content=ft.Container(
                padding=15,
                content=ft.Column(
                    [
                        ft.Row([ft.Icon(icon, size=50, color=color), ft.Text(title, size=18, color=ft.Colors.GREY_700)],
                               spacing=8),
                        ft.Text(str(value), size=20, weight=ft.FontWeight.BOLD),
                    ],
                    alignment=ft.MainAxisAlignment.CENTER,
                ),
            ),
        )

    def refresh(self):
        self.load_ui()
        self.update()
